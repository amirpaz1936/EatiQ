FROM node:22-bookworm-slim

# Build tools for bcrypt's native binding on Linux (needed by auth-service).
# Harmless for the other services; keeps a single shared image.
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 make g++ \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Manifests first so the npm install layer is cacheable.
COPY package.json package-lock.json ./
COPY apps/auth-service/package.json      apps/auth-service/
COPY apps/backend/package.json           apps/backend/
COPY apps/frontend/package.json          apps/frontend/
COPY apps/image-recognition/package.json apps/image-recognition/
COPY packages/db/package.json            packages/db/

RUN npm install --workspaces --include-workspace-root

# Each compose service overrides working_dir + command.
