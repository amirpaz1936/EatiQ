PORT=3000
# Defaults assume the backend runs OUTSIDE docker (against published ports).
# docker-compose.dev.yml overrides MONGODB_URI, S3_INTERNAL_ENDPOINT, and
# IMAGE_RECOGNITION_URL to use the in-network hostnames.
MONGODB_URI=mongodb://localhost:27017/eatiq

# Redis cache (meal suggestions). Override to redis://redis:6379 inside docker (compose does this).
REDIS_URL=redis://localhost:6379

# OpenAI — used by the meal-suggestion route to generate meals.
OPENAI_API_KEY=
OPENAI_SUGGESTIONS_MODEL=gpt-4o-mini

# S3 / Minio
S3_BUCKET=eatiq-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# Browser-facing endpoint (presigned PUT URLs use this host; always the host's localhost)
S3_PUBLIC_ENDPOINT=http://localhost:9000
# Endpoint the backend uses to sign GET URLs for image-recognition.
# Override to http://minio:9000 inside docker (compose does this).
S3_INTERNAL_ENDPOINT=http://localhost:9000

# Downstream service. Override to http://image-recognition:3001 inside docker (compose does this).
IMAGE_RECOGNITION_URL=http://localhost:3001
