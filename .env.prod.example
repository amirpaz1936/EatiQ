# Production secrets/config for docker-compose.prod.yml.
#
# Copy to .env.prod and fill in. It's loaded via `--env-file .env.prod`
# (see the docker:prod npm scripts) and interpolated into the compose ${VARS}.
# .env.prod is gitignored — never commit real secrets.

# ─── Database (host MongoDB) ───
# Defaults to the VM's mongod via host.docker.internal. Override only if it's
# elsewhere. The host mongod must accept connections from the docker bridge — see
# the PR notes / README for how to validate reachability.
# MONGODB_URI=mongodb://host.docker.internal:27017/eatiq

# ─── Auth service ───
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── OpenAI ───
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_SUGGESTIONS_MODEL=gpt-4o-mini
OPENAI_INSIGHTS_MODEL=gpt-4o-mini

# ─── Cloudflare R2 (S3-compatible object storage) ───
# Access key id / secret from the Cloudflare dashboard (R2 > Manage API Tokens).
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=eatiq-uploads
R2_ENDPOINT=https://5d398f1808bdc3fc022c13c1eac22c74.r2.cloudflarestorage.com
# NOTE: configure CORS on the R2 bucket to allow https://eatiq.cs.colman.ac.il
# (PUT for uploads) so the browser's presigned upload succeeds.

# ─── Frontend ───
# Same-origin in prod; baked into the static bundle at build time.
VITE_API_BASE_URL=https://eatiq.cs.colman.ac.il
# Host directory the built SPA is published to. MUST match `root` in the host
# nginx site config (infra/nginx/eatiq.host.conf, default /var/www/eatiq).
FRONTEND_DIST_DIR=/var/www/eatiq
