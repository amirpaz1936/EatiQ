{
  "name": "eatiq",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml down",
    "docker:dev:logs": "docker compose -f docker-compose.dev.yml logs -f",
    "docker:prod": "docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build",
    "docker:prod:frontend": "docker compose --env-file .env.prod -f docker-compose.prod.yml --profile frontend run --rm --build frontend-build",
    "docker:prod:down": "docker compose --env-file .env.prod -f docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose --env-file .env.prod -f docker-compose.prod.yml logs -f"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "npm@10.9.2"
}
